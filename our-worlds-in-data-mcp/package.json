  },
  "keywords": [
    "mcp",
    "owid",
    "our-world-in-data",
    "data"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.6.0"
  }
}

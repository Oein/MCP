{
  "name": "our-world-in-data-mcp",
  "version": "0.1.0",
  "description": "Our World in Data 공개 API를 노출하는 MCP 서버",
  "type": "module",
  "bin": {
    "our-world-in-data-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
